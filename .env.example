# Copy to .env and fill in. Both are optional: without them the pipeline still
# runs end to end, using a mock for the payment API and fixed templates for the
# customer messages.

# Razorpay test-mode keys. Dashboard -> Settings -> API Keys, in Test Mode.
# With these set, payment link actions call the real test-mode API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Groq key, from console.groq.com. With this set, customer messages are
# written by the model rather than taken from a template. Generated text is
# checked before it is used, see agent/messenger.py.
GROQ_API_KEY=
# Free-tier keys cannot reach the Llama models. To see what yours can use:
#   GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
