# Copy this file to .env and fill in your Razorpay TEST MODE credentials.
# Get these from Razorpay Dashboard -> Settings -> API Keys (make sure you're in Test Mode).
# If left blank, the executor automatically runs in MOCK mode (no real API calls) so the
# pipeline still runs end-to-end without credentials.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
